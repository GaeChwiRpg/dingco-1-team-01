# 이 파일을 .env 로 복사해서 채운다. .env 는 .gitignore 로 차단돼 있다.
# 비밀 정보 commit 은 헌법 「작업 경계」상 절대 금지.

# ── DB ───────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=triage_db
DB_USER=triage
DB_PASSWORD=change-me
DB_PORT=3306

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Flyway ───────────────────────────────────────────────────
# 1 = V1 만 (기본). 측정 5ⓔ 를 돌릴 때만 2 로 올려 후보 인덱스를 켠다 (D-023).
FLYWAY_TARGET=1

# ── AI ───────────────────────────────────────────────────────
# P2(분류·검증) 착수 시 사용. 프로바이더가 문서 간에 어긋나 있어 아직 확정 전이다
# (D-003/PRD 는 OpenAI, API-CONTRACT §3 예시는 claude-sonnet-5).
# 키는 환경변수로만 주입한다 — 코드/설정 파일 하드코딩 금지.
AI_API_KEY=

# ── 수신 인증 (Phase 2 stub) ─────────────────────────────────
# POST /api/errors 의 X-Api-Key. JWT 본격 통합은 Phase 3.
SDK_API_KEY=sdk-live-change-me
