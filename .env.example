# 이 파일을 .env 로 복사해서 채운다. .env 는 .gitignore 로 차단돼 있다.
# 비밀 정보 commit 은 헌법 「작업 경계」상 절대 금지.

# ── DB ───────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=change-me-root
DB_NAME=triage_db
DB_USER=triage
DB_PASSWORD=change-me
DB_PORT=3306

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Flyway ───────────────────────────────────────────────────
# 1 = V1 만 (기본). 측정 5ⓔ 를 돌릴 때만 2 로 올려 후보 인덱스를 켠다 (D-023).
FLYWAY_TARGET=1

# ── AI ───────────────────────────────────────────────────────
# P2(분류·검증) 착수 시 사용. 프로바이더는 Anthropic 확정 (D-024), 모델은 claude-sonnet-5.
# 이름을 ANTHROPIC_API_KEY 로 두면 SDK 가 자동으로 읽는다 (AnthropicOkHttpClient.fromEnv()).
# 키는 console.anthropic.com 에서 발급. 환경변수로만 주입한다 — 코드/설정 파일 하드코딩 금지.
ANTHROPIC_API_KEY=

# ── 수신 인증 (Phase 2 stub) ─────────────────────────────────
# POST /api/errors 의 X-Api-Key. JWT 본격 통합은 Phase 3.
SDK_API_KEY=sdk-live-change-me

# ── Sentry (배포·운영, MONITORING.md) ─────────────────────────
# sentry.io 프로젝트 생성 후 발급받은 DSN. 비어 있으면 SDK 가 no-op 으로 동작하므로
# 로컬 개발 중엔 비워둬도 앱 기동에는 문제없다. 코드/설정 파일에 하드코딩 금지.
SENTRY_DSN=
