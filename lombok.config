# 팀 헌법 Lombok 규칙 (D-057). 여기서 멈추고 상위로 더 뒤지지 않는다.
config.stopBubbling = true

# @Data · @Setter 금지 — 사용 시 컴파일 에러.
#
# 왜: 도메인 객체(Inquiry 등)에 무분별한 setter 가 생기면, 상태 변경이 "의미를 가진 메서드"가
# 아니라 필드 노출로 새어 나간다. 그러면 불변 규칙(예: current_* 는 판정 확정 트랜잭션 안에서만
# 갱신, D-011)을 지킬 자리가 사라진다. @Data 는 @Setter 를 품으므로 함께 막는다.
#
# 허용: @Getter · @RequiredArgsConstructor · @AllArgsConstructor · @Builder · @Slf4j · @Value 등.
lombok.data.flagUsage = error
lombok.setter.flagUsage = error
